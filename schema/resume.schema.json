{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/resume.schema.json",
  "title": "Resume",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "headline", "summary", "skills", "experience", "education"],
  "properties": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "location", "email", "phone", "linkedin", "websites"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email", "minLength": 3 },
        "phone": { "type": "string", "minLength": 1 },
        "linkedin": { "type": "string", "format": "uri", "minLength": 1 },
        "websites": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri", "minLength": 1 }
        }
      }
    },
    "headline": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "projects": {
      "type": "array",
      "items": { "$ref": "#/$defs/project" }
    },
    "experience": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/experience" }
    },
    "education": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/education" }
    }
  },
  "$defs": {
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company", "location", "roles"],
      "properties": {
        "company": { "type": "string", "minLength": 1 },
        "location": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z .'-]+, [A-Z]{2}$"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/role" }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "start", "end"],
      "anyOf": [
        { "required": ["description"] },
        { "required": ["bullets"] }
      ],
      "allOf": [
        {
          "if": { "required": ["bullets"] },
          "then": { "required": ["description"] }
        }
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/monthDate" },
        "end": { "$ref": "#/$defs/endDate" },
        "description": { "type": "string", "minLength": 1 },
        "bullets": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "education": {
      "type": "object",
      "additionalProperties": false,
      "required": ["institution", "location", "degree", "start"],
      "properties": {
        "institution": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "degree": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/educationDate" },
        "end": { "$ref": "#/$defs/educationDate" }
      }
    },
    "monthDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "endDate": {
      "type": "string",
      "pattern": "^([0-9]{4}-(0[1-9]|1[0-2])|present)$"
    },
    "educationDate": {
      "type": "string",
      "pattern": "^[0-9]{4}(-((0[1-9])|(1[0-2])))?$"
    }
  }
}
